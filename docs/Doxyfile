# Doxygen configuration for dwm.
#
# Function contracts live at their definitions in dwm.c / drw.c / util.c and
# in the public headers. The subsystem contract is docs/ARCHITECTURE.md,
# which is also the generated documentation main page.
#
# Run from the repository root:
#   doxygen docs/Doxyfile      (or: make docs)
#   $BROWSER docs/build/html/index.html

PROJECT_NAME           = "dwm"
PROJECT_BRIEF          = "Dynamic window manager — architecture and function contracts"
OUTPUT_DIRECTORY       = docs/build
CREATE_SUBDIRS          = NO
ALLOW_UNICODE_NAMES     = YES

OPTIMIZE_OUTPUT_FOR_C   = YES
EXTRACT_ALL             = NO
EXTRACT_STATIC          = YES
EXTRACT_LOCAL_CLASSES   = YES
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO

INPUT                  = dwm.c \
                         drw.c \
                         util.c \
                         dwm.h \
                         drw.h \
                         util.h \
                         docs/ARCHITECTURE.md
FILE_PATTERNS           = *.c *.h *.md
RECURSIVE               = NO
USE_MDFILE_AS_MAINPAGE  = docs/ARCHITECTURE.md

JAVADOC_AUTOBRIEF       = NO
QT_AUTOBRIEF            = NO
MULTILINE_CPP_IS_BRIEF  = NO
TAB_SIZE                = 8

QUIET                   = YES
WARNINGS                = YES
# Undocumented-global warnings are noise: the contract coverage that matters
# (every function has an anchor and a mapped test) is enforced by
# `make spec-check`. Keep doc-error and parameter warnings strict.
WARN_IF_UNDOCUMENTED    = NO
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = NO

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_LATEX          = NO
GENERATE_MAN             = NO
GENERATE_XML            = NO
HAVE_DOT                = NO

SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES
